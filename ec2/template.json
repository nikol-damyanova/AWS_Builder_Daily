{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "Builder persistent-browser VM with daily schedules disabled by default.",
  "Parameters": {
    "VpcId": {
      "Type": "AWS::EC2::VPC::Id"
    },
    "SubnetId": {
      "Type": "AWS::EC2::Subnet::Id"
    },
    "StateTableName": {
      "Type": "String"
    },
    "UbuntuAmi": {
      "Type": "AWS::EC2::Image::Id",
      "Description": "Verified official Canonical Ubuntu 24.04 amd64 AMI in us-east-1"
    },
    "ScheduleStart": {
      "Type": "String",
      "Description": "UTC timestamp for start of schedule window"
    },
    "ScheduleEnd": {
      "Type": "String",
      "Description": "UTC timestamp for end of schedule window"
    },
    "ScheduleState": {
      "Type": "String",
      "Default": "DISABLED",
      "AllowedValues": [
        "DISABLED",
        "ENABLED"
      ]
    }
  },
  "Resources": {
    "SecurityGroup": {
      "Type": "AWS::EC2::SecurityGroup",
      "Properties": {
        "GroupDescription": "Builder VM: no inbound ports; desktop through authenticated SSM tunnel",
        "VpcId": {
          "Ref": "VpcId"
        },
        "SecurityGroupEgress": [
          {
            "IpProtocol": "-1",
            "CidrIp": "0.0.0.0/0"
          }
        ]
      }
    },
    "WorkerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "ec2.amazonaws.com"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        },
        "ManagedPolicyArns": [
          "arn:aws:iam::aws:policy/AmazonSSMManagedInstanceCore"
        ],
        "Policies": [
          {
            "PolicyName": "BuilderTaskOnly",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "dynamodb:GetItem",
                    "dynamodb:PutItem",
                    "dynamodb:UpdateItem"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:dynamodb:${AWS::Region}:${AWS::AccountId}:table/${StateTableName}"
                  },
                  "Condition": {
                    "DateLessThan": {
                      "aws:CurrentTime": {
                        "Ref": "ScheduleEnd"
                      }
                    }
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "InstanceProfile": {
      "Type": "AWS::IAM::InstanceProfile",
      "Properties": {
        "Roles": [
          {
            "Ref": "WorkerRole"
          }
        ]
      }
    },
    "VM": {
      "Type": "AWS::EC2::Instance",
      "Properties": {
        "InstanceType": "t3.small",
        "ImageId": {
          "Ref": "UbuntuAmi"
        },
        "IamInstanceProfile": {
          "Ref": "InstanceProfile"
        },
        "CreditSpecification": {
          "CPUCredits": "standard"
        },
        "MetadataOptions": {
          "HttpTokens": "required",
          "HttpEndpoint": "enabled"
        },
        "NetworkInterfaces": [
          {
            "DeviceIndex": "0",
            "AssociatePublicIpAddress": true,
            "SubnetId": {
              "Ref": "SubnetId"
            },
            "GroupSet": [
              {
                "Ref": "SecurityGroup"
              }
            ]
          }
        ],
        "BlockDeviceMappings": [
          {
            "DeviceName": "/dev/sda1",
            "Ebs": {
              "Encrypted": true,
              "VolumeType": "gp3",
              "VolumeSize": 20,
              "DeleteOnTermination": false
            }
          }
        ],
        "Tags": [
          {
            "Key": "Name",
            "Value": "builder-daily-90-persistent"
          }
        ],
        "UserData": {
          "Fn::Base64": "#!/bin/bash\nset -eu\n# Stop after first boot. Install and verify browser/job through SSM before enabling schedules.\nshutdown -h +15\n"
        }
      }
    },
    "SchedulerRole": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "Service": "scheduler.amazonaws.com"
              },
              "Action": "sts:AssumeRole",
              "Condition": {
                "StringEquals": {
                  "aws:SourceAccount": {
                    "Ref": "AWS::AccountId"
                  }
                },
                "ArnEquals": {
                  "aws:SourceArn": {
                    "Fn::Sub": "arn:${AWS::Partition}:scheduler:${AWS::Region}:${AWS::AccountId}:schedule-group/default"
                  }
                }
              }
            }
          ]
        },
        "Policies": [
          {
            "PolicyName": "OnlyStartStopBuilderVM",
            "PolicyDocument": {
              "Version": "2012-10-17",
              "Statement": [
                {
                  "Effect": "Allow",
                  "Action": [
                    "ec2:StartInstances",
                    "ec2:StopInstances"
                  ],
                  "Resource": {
                    "Fn::Sub": "arn:${AWS::Partition}:ec2:${AWS::Region}:${AWS::AccountId}:instance/${VM}"
                  }
                }
              ]
            }
          }
        ]
      }
    },
    "StartSchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "State": {
          "Ref": "ScheduleState"
        },
        "ScheduleExpression": "cron(55 11 * * ? *)",
        "ScheduleExpressionTimezone": "Europe/Sofia",
        "StartDate": {
          "Ref": "ScheduleStart"
        },
        "EndDate": {
          "Ref": "ScheduleEnd"
        },
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:scheduler:::aws-sdk:ec2:startInstances"
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"InstanceIds\":[\"${VM}\"]}"
          },
          "RetryPolicy": {
            "MaximumRetryAttempts": 1,
            "MaximumEventAgeInSeconds": 300
          }
        }
      }
    },
    "StopSchedule": {
      "Type": "AWS::Scheduler::Schedule",
      "Properties": {
        "State": {
          "Ref": "ScheduleState"
        },
        "ScheduleExpression": "cron(15 12 * * ? *)",
        "ScheduleExpressionTimezone": "Europe/Sofia",
        "StartDate": {
          "Ref": "ScheduleStart"
        },
        "EndDate": {
          "Ref": "ScheduleEnd"
        },
        "FlexibleTimeWindow": {
          "Mode": "OFF"
        },
        "Target": {
          "Arn": {
            "Fn::Sub": "arn:${AWS::Partition}:scheduler:::aws-sdk:ec2:stopInstances"
          },
          "RoleArn": {
            "Fn::GetAtt": [
              "SchedulerRole",
              "Arn"
            ]
          },
          "Input": {
            "Fn::Sub": "{\"InstanceIds\":[\"${VM}\"]}"
          },
          "RetryPolicy": {
            "MaximumRetryAttempts": 1,
            "MaximumEventAgeInSeconds": 300
          }
        }
      }
    }
  },
  "Outputs": {
    "InstanceId": {
      "Value": {
        "Ref": "VM"
      }
    },
    "WorkerRoleArn": {
      "Value": {
        "Fn::GetAtt": [
          "WorkerRole",
          "Arn"
        ]
      }
    }
  }
}
